# Public site URL, used for metadata, sitemap and canonical links
NEXT_PUBLIC_SITE_URL=https://www.techxsystems.com

# ── Free-trial uploads (docs/uploads.md) ──────────────────────────────────────────
# Signs upload tickets and the admin session, and encrypts the stored Dropbox / Google tokens. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
# Sign-in for /admin: an email and a password (owner, 2026-11-03). Sign-in tries are rate-limited.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Dropbox app (App folder access; scopes files.content.write, account_info.read)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Google Cloud OAuth client (Web application; Drive API enabled; scope drive.file)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Database (owner, 2026-11-03) ───────────────────────────────────────────────────
# PostgreSQL link for everything edited in /admin (content, prices, services, blog, SEO, upload settings).
# Neon / Supabase / Vercel Postgres / Railway all work; a pooled link is fine. After pasting it, run once:
#   npm run db:setup      (creates the table and copies anything saved locally)
DATABASE_URL=

# Optional alternative to the database: Upstash Redis. Used only when DATABASE_URL is empty. With neither, saves live
# in .data/ (local development only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Admin panel photo uploads (Vercel → Storage → Blob → connect to the project; Vercel sets this for you)
BLOB_READ_WRITE_TOKEN_READ_WRITE_TOKEN=

# Email alerts to the studio for contact messages and free trials, through Resend (lib/server/email.ts).
# A send-only API key is enough. MAIL_FROM must be on a domain verified in Resend (e.g. "TechX website <website@techxsystems.com>").
# MAIL_TO: who gets the alerts (comma-separated; defaults to the site's contact email). Visitors are never emailed.
# Caps protect credits (defaults sit under Resend's free 100 a day / 3,000 a month); past a cap the email is skipped,
# the submission is still saved in the upload folder.
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO=
MAIL_DAILY_CAP=90
MAIL_MONTHLY_CAP=2900
