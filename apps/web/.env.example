# Public site URL, used for metadata, sitemap and canonical links
NEXT_PUBLIC_SITE_URL=https://www.techxsystems.com

# ── Free-trial uploads (docs/uploads.md) ──────────────────────────────────────────
# Signs upload tickets and the admin session, and encrypts the stored Dropbox / Google tokens. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
# Password for /admin, where the admin connects Dropbox / Google Drive and picks where uploads land
ADMIN_PASSWORD=

# Dropbox app (App folder access; scopes files.content.write, account_info.read)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Google Cloud OAuth client (Web application; Drive API enabled; scope drive.file)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Settings store for production (Upstash Redis, free tier is plenty). Without it, settings live in .data/ (local only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
